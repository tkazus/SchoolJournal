<Window x:Class="SchoolJournal.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌟 Школьный дневник" Height="875" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="RoleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RoleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="ScaleUpStoryboard">
            <DoubleAnimation From="0.95" To="1.05" Duration="0:0:0.15" 
                             Storyboard.TargetProperty="RenderTransform.ScaleX"/>
            <DoubleAnimation From="0.95" To="1.05" Duration="0:0:0.15" 
                             Storyboard.TargetProperty="RenderTransform.ScaleY"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE8F0F8" Offset="0"/>
                <GradientStop Color="#FFF5F0FF" Offset="0.5"/>
                <GradientStop Color="#FFF5E8F0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#FFE8F0F8" CornerRadius="0 0 100 0" 
                Width="400" Height="200" Margin="-50,-50,0,0" Opacity="0.3"/>

        <Button Content="✕" FontSize="18" FontWeight="Bold" 
                Background="Transparent" BorderThickness="0" 
                Cursor="Hand" Foreground="#FF8A7A9A"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,25,0" Click="CloseButton_Click"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50">
            <StackPanel Margin="0,0,0,40">
                <TextBlock Text="🌟" FontSize="50" TextAlignment="Center"/>
                <TextBlock Text="Добро пожаловать!" FontSize="32" FontWeight="Bold" 
                           Foreground="#FF4A6B7A" TextAlignment="Center"/>
                <TextBlock Text="Выберите свою роль для входа в систему" FontSize="16" 
                           Foreground="#FF7A9AAA" TextAlignment="Center" Margin="0,8,0,0"/>
                <Border Background="#FFD4E8F0" CornerRadius="10" Padding="10" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔗 Сервер: " FontSize="12" Foreground="#FF6B8A9A"/>
                        <TextBlock x:Name="ServerStatusText" Text="Подключение..." FontSize="12" 
                                   Foreground="#FF4A6B7A" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ученик -->
                <Button Style="{StaticResource RoleButtonStyle}" Grid.Row="0" Grid.Column="0" 
                        Margin="10" Click="StudentButton_Click">
                    <Border Style="{StaticResource RoleCardStyle}" Padding="25">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource ScaleUpStoryboard}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="🎒" FontSize="48" TextAlignment="Center"/>
                            <TextBlock Text="Ученик" FontSize="20" FontWeight="Bold" 
                                       Foreground="#FF4A6B7A" TextAlignment="Center" Margin="0,10,0,5"/>
                            <TextBlock Text="Просмотр оценок, расписания, ДЗ" FontSize="12" 
                                       Foreground="#FF7A9AAA" TextAlignment="Center"/>
                            <TextBlock Text="и управление жетонами" FontSize="12" 
                                       Foreground="#FF7A9AAA" TextAlignment="Center"/>
                            <Border Background="#FFB8D4E3" CornerRadius="10" Padding="8,3" Margin="0,15,0,0">
                                <TextBlock Text="Войти →" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="#FF4A6B7A" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Учитель -->
                <Button Style="{StaticResource RoleButtonStyle}" Grid.Row="0" Grid.Column="1" 
                        Margin="10" Click="TeacherButton_Click">
                    <Border Style="{StaticResource RoleCardStyle}" Padding="25">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource ScaleUpStoryboard}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="👩‍🏫" FontSize="48" TextAlignment="Center"/>
                            <TextBlock Text="Учитель" FontSize="20" FontWeight="Bold" 
                                       Foreground="#FF5A4A7A" TextAlignment="Center" Margin="0,10,0,5"/>
                            <TextBlock Text="Управление классами, оценками," FontSize="12" 
                                       Foreground="#FF8A7AAA" TextAlignment="Center"/>
                            <TextBlock Text="ДЗ и посещаемостью" FontSize="12" 
                                       Foreground="#FF8A7AAA" TextAlignment="Center"/>
                            <Border Background="#FFE0D0E8" CornerRadius="10" Padding="8,3" Margin="0,15,0,0">
                                <TextBlock Text="Войти →" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="#FF5A4A7A" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Родитель -->
                <Button Style="{StaticResource RoleButtonStyle}" Grid.Row="1" Grid.Column="0" 
                        Margin="10" Click="ParentButton_Click">
                    <Border Style="{StaticResource RoleCardStyle}" Padding="25">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource ScaleUpStoryboard}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="👨‍👩‍👦" FontSize="48" TextAlignment="Center"/>
                            <TextBlock Text="Родитель" FontSize="20" FontWeight="Bold" 
                                       Foreground="#FF7A4A5A" TextAlignment="Center" Margin="0,10,0,5"/>
                            <TextBlock Text="Просмотр успеваемости," FontSize="12" 
                                       Foreground="#FF9A7A8A" TextAlignment="Center"/>
                            <TextBlock Text="ДЗ и посещаемости ребенка" FontSize="12" 
                                       Foreground="#FF9A7A8A" TextAlignment="Center"/>
                            <Border Background="#FFE8D0D0" CornerRadius="10" Padding="8,3" Margin="0,15,0,0">
                                <TextBlock Text="Войти →" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="#FF7A4A5A" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Администратор -->
                <Button Style="{StaticResource RoleButtonStyle}" Grid.Row="1" Grid.Column="1" 
                        Margin="10" Click="AdminButton_Click">
                    <Border Style="{StaticResource RoleCardStyle}" Padding="25">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource ScaleUpStoryboard}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="⚙️" FontSize="48" TextAlignment="Center"/>
                            <TextBlock Text="Администратор" FontSize="20" FontWeight="Bold" 
                                       Foreground="#FF4A3A6A" TextAlignment="Center" Margin="0,10,0,5"/>
                            <TextBlock Text="Полный доступ к управлению" FontSize="12" 
                                       Foreground="#FF7A6A9A" TextAlignment="Center"/>
                            <TextBlock Text="системой и пользователями" FontSize="12" 
                                       Foreground="#FF7A6A9A" TextAlignment="Center"/>
                            <Border Background="#FFD8C8E8" CornerRadius="10" Padding="8,3" Margin="0,15,0,0">
                                <TextBlock Text="Войти →" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="#FF4A3A6A" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <TextBlock Text="🌸 Система электронного школьного журнала v2.0 (Client-Server)" 
                       FontSize="11" Foreground="#FFAABACA" 
                       TextAlignment="Center" Margin="0,30,0,0"/>
        </StackPanel>
    </Grid>
</Window>