<Window x:Class="SchoolJournal.Client.Windows.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏪 Магазин" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🏪 Магазин жетонов" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="💰 Ваш баланс: " FontSize="14" Foreground="#FF6B8A9A"/>
                    <TextBlock x:Name="BalanceText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF2A6A4A"/>
                    <TextBlock Text=" 🪙" FontSize="18"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="🛍️ Доступные товары" FontSize="16" FontWeight="SemiBold" 
                           Foreground="#FF4A6B7A" Margin="0,0,0,10"/>

                <ItemsControl x:Name="ShopItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF8FAFC" CornerRadius="10" Padding="15" Margin="0,4,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
                                        <TextBlock FontSize="12" Foreground="#FFAABACA">В наличии: <Run Text="{Binding Quantity}"/></TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Price}" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                                        <TextBlock Text="🪙" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="🛒 Купить" 
                                                Background="#FF6BB5A0" Foreground="White"
                                                FontSize="13" FontWeight="SemiBold" 
                                                Height="35" Width="100"
                                                Tag="{Binding}"
                                                Click="BuyButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="📜 История покупок" FontSize="16" FontWeight="SemiBold" 
                           Foreground="#FF4A6B7A" Margin="0,20,0,10"/>

                <ItemsControl x:Name="PurchasesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ItemName}" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Foreground="#FF7A9AAA" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="#FF8A9AAA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SpentTokens, StringFormat={}{0} 🪙}" Foreground="#FF7A4A4A" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>