<Window x:Class="SchoolJournal.Client.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Администратор" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="⚙️ Панель администратора" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="AdminNameText" Text="Администратор" FontSize="14" Foreground="#FF6B8A9A"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel Margin="0,0,0,15">
                    <Button Content="👤 Пользователи" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="UsersButton_Click"/>
                    <Button Content="🏫 Классы" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="ClassesButton_Click"/>
                    <Button Content="👨‍🎓 Ученики" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="StudentsButton_Click"/>
                    <Button Content="👩‍🏫 Учителя" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="TeachersButton_Click"/>
                    <Button Content="📚 Предметы" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="SubjectsButton_Click"/>
                    <Button Content="📅 Расписание" Background="#FFD5C8E8" Foreground="#FF4A3A6A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="ScheduleButton_Click"/>
                </WrapPanel>

                <TextBlock Text="📊 Данные системы" FontSize="16" FontWeight="SemiBold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                <ItemsControl x:Name="DataItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Login}" Foreground="#FF7A9AAA" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="#FF6B8A9A" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Class}" Foreground="#FF8A9AAA" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Specialty}" Foreground="#FFAABACA" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="Transparent" Padding="0,10,0,0">
            <Grid>
                <Button Content="🚪 Выход" Background="#FFE0D0D0" Foreground="#FF7A4A4A" 
                        FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                        HorizontalAlignment="Right" Click="LogoutButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>