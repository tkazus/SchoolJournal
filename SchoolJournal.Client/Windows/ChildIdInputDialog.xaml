<Window x:Class="SchoolJournal.Client.Windows.ChildIdInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👨‍👩‍👦 Введите ID ребенка" Height="268" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="👨‍👩‍👦 Введите ID ребенка" FontSize="18" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock Text="Введите ID ребенка, чтобы просмотреть его данные" FontSize="12" Foreground="#FF8A9AAA"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="🆔 ID ребенка" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <TextBox x:Name="txtChildId" Height="35" Padding="5" Text="1" 
                     Background="White" BorderBrush="#FFD4E8F0" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✅ OK" Background="#FF6BB5A0" Foreground="White"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                    Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="❌ Отмена" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>