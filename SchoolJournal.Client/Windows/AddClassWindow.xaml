<Window x:Class="SchoolJournal.Client.Windows.AddClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏫 Добавить класс" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🏫 Добавить класс" FontSize="20" FontWeight="Bold" Foreground="#FF4A6B7A"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="📚 Название класса" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <TextBox x:Name="ClassNameBox" Height="35" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="📅 Год обучения" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <TextBox x:Name="YearBox" Height="35" Padding="5" Text="2025"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✅ Добавить" Background="#FF6BB5A0" Foreground="White"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button Content="❌ Отмена" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>