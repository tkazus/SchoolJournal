<Window x:Class="SchoolJournal.Client.Windows.ManageScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📅 Управление расписанием" Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📅 Управление расписанием" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <Button Content="➕ Добавить занятие" Background="#FF6BB5A0" Foreground="White"
                        FontSize="13" FontWeight="SemiBold" Height="30" Width="130"
                        HorizontalAlignment="Right" Click="AddScheduleButton_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScheduleItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8FAFC" CornerRadius="8" Padding="12" Margin="0,3,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubjectName}" Foreground="#FF6B8A9A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TeacherName}" Foreground="#FF7A9AAA" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="#FF8A9AAA" VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="4" Content="🗑️ Удалить" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                                        FontSize="12" FontWeight="SemiBold" Height="28" Width="80"
                                        Tag="{Binding ScheduleId}" Click="DeleteButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>