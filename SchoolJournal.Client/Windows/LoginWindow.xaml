<Window x:Class="SchoolJournal.Client.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Вход в систему" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LoginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF7A4A5A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5A3A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFF5F0F0" 
                                BorderThickness="0" 
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#FFF5F0F0" 
                                BorderThickness="0" 
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE8F0F8" Offset="0"/>
                <GradientStop Color="#FFF5F0FF" Offset="0.5"/>
                <GradientStop Color="#FFF5E8F0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#FFE8F0F8" CornerRadius="0 0 100 0" 
                Width="400" Height="200" Margin="-50,-50,0,0" Opacity="0.3"/>

        <Button Content="✕" FontSize="18" FontWeight="Bold" 
                Background="Transparent" BorderThickness="0" 
                Cursor="Hand" Foreground="#FF8A7A9A"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,25,0" Click="CloseButton_Click"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <TextBlock x:Name="TitleText" Text="" FontSize="32" FontWeight="Bold" 
                       Foreground="#FF4A6B7A" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock x:Name="SubtitleText" Text="Вход в систему" FontSize="18" Foreground="#FF7A9AAA" 
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock x:Name="RoleIconText" Text="👤" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Border Style="{StaticResource LoginCardStyle}" Padding="30,30,30,30">
                <StackPanel>
                    <TextBlock Text="👤 Логин" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#FF7A4A5A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="40" FontSize="14" 
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="🔑 Пароль" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#FF7A4A5A" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="40" FontSize="14" 
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Margin="0,0,0,20"/>

                    <Button x:Name="btnLogin" Content="🔑 Войти" Style="{StaticResource LoginButtonStyle}"
                            Click="LoginButton_Click"/>

                    <TextBlock x:Name="txtError" Foreground="#FFD04A4A" 
                               FontSize="13" HorizontalAlignment="Center" 
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="© 2026 Школьный дневник 🌸" FontSize="11" Foreground="#FFAA8A8A" 
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>