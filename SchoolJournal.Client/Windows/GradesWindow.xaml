<Window x:Class="SchoolJournal.Client.Windows.GradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 Оценки" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📖 Мои оценки" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="StudentInfoText" Text="Ученик: " FontSize="14" Foreground="#FF6B8A9A"/>
                <TextBlock x:Name="SummaryText" Text="Средний балл: 0.0" FontSize="13" Foreground="#FF8A9AAA"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GradesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8FAFC" CornerRadius="8" Padding="12" Margin="0,3,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{Binding GradeColor}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="18" Foreground="{Binding GradeTextColor}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="#FF7A9AAA" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Teacher}" Foreground="#FF8A9AAA" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Comment}" Foreground="#FFAABACA" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>