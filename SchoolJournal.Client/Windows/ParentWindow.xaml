<Window x:Class="SchoolJournal.Client.Windows.ParentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👨‍👩‍👦 Родитель" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="👨‍👩‍👦 Родительский контроль" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="ParentNameText" Text="Родитель" FontSize="14" Foreground="#FF6B8A9A"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="👩‍🎓 Информация о ребенке" FontSize="18" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="ФИО:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="0" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildNameText" Grid.Row="0" Grid.Column="1" Margin="5,5" Foreground="#FF4A6B7A" FontWeight="SemiBold"/>

                            <TextBlock Text="Класс:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="1" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildClassText" Grid.Row="1" Grid.Column="1" Margin="5,5" Foreground="#FF4A6B7A"/>

                            <TextBlock Text="Дата рождения:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="2" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildBirthDateText" Grid.Row="2" Grid.Column="1" Margin="5,5" Foreground="#FF7A9AAA"/>

                            <TextBlock Text="Средний балл:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="3" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildAvgGradeText" Grid.Row="3" Grid.Column="1" Margin="5,5" Foreground="#FF4A6B7A" FontWeight="SemiBold"/>

                            <TextBlock Text="Посещаемость:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="4" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildAttendanceText" Grid.Row="4" Grid.Column="1" Margin="5,5" Foreground="#FF4A6B7A" FontWeight="SemiBold"/>

                            <TextBlock Text="Баланс жетонов:" FontWeight="SemiBold" Foreground="#FF6B8A9A" Grid.Row="5" Grid.Column="0" Margin="5,5"/>
                            <TextBlock x:Name="ChildTokensText" Grid.Row="5" Grid.Column="1" Margin="5,5" Foreground="#FF2A6A4A" FontWeight="Bold" FontSize="20"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,0,0,15">
                    <Button Content="📖 Оценки" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="110" Margin="0,0,10,0"
                            Click="GradesButton_Click"/>
                    <Button Content="📅 Расписание" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="ScheduleButton_Click"/>
                    <Button Content="📝 Домашнее задание" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="150" Margin="0,0,10,0"
                            Click="HomeworkButton_Click"/>
                    <Button Content="✅ Посещаемость" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="AttendanceButton_Click"/>
                    <Button Content="🪙 Жетоны" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="TokensButton_Click"/>
                </WrapPanel>

                <Border Background="White" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📝 Ближайшие домашние задания" FontSize="16" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="HomeworkItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF6B8A9A" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat=Срок: dd.MM.yyyy}" FontSize="12" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="Transparent" Padding="0,10,0,0">
            <Grid>
                <Button Content="🚪 Выход" Background="#FFE0D0D0" Foreground="#FF7A4A4A" 
                        FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                        HorizontalAlignment="Right" Click="LogoutButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>