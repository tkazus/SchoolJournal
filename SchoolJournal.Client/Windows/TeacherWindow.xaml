<Window x:Class="SchoolJournal.Client.Windows.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👩‍🏫 Учитель" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="👩‍🏫 Учительский кабинет" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="TeacherNameText" Text="Учитель" FontSize="14" Foreground="#FF6B8A9A"/>
                <TextBlock x:Name="ClassInfoText" Text="Класс: " FontSize="13" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="👨‍🎓 Учеников" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="StudentsCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,5,0" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="📊 Средний балл" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="AvgGradeText" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,0,0" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="✅ Успеваемость" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="SuccessRateText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel Margin="0,0,0,15">
                    <Button Content="📖 Мои классы" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="ClassesButton_Click"/>
                    <Button Content="📝 Выставить оценки" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="140" Margin="0,0,10,0"
                            Click="AddGradeButton_Click"/>
                    <Button Content="📚 Домашнее задание" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="150" Margin="0,0,10,0"
                            Click="AddHomeworkButton_Click"/>
                    <Button Content="✅ Посещаемость" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="AttendanceButton_Click"/>
                    <Button Content="🪙 Начислить жетоны" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="140" Margin="0,0,10,0"
                            Click="AddTokensButton_Click"/>
                    <Button Content="📊 Статистика" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="StatisticsButton_Click"/>
                </WrapPanel>

                <Border Background="White" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="👨‍🎓 Список учеников" FontSize="16" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="StudentsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AverageGrade, StringFormat={}{0:F1}}" Foreground="#FF7A9AAA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Attendance, StringFormat={}{0:F0}%}" Foreground="#FF8A9AAA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Tokens}" Foreground="#FF4A6B7A" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Grid.Column="4" Content="📊" Background="Transparent" BorderThickness="0" 
                                                    FontSize="16" Cursor="Hand" Tag="{Binding StudentId}"
                                                    Click="StudentStatsButton_Click" ToolTip="Статистика ученика"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="Transparent" Padding="0,10,0,0">
            <Grid>
                <Button Content="🚪 Выход" Background="#FFE0D0D0" Foreground="#FF7A4A4A" 
                        FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                        HorizontalAlignment="Right" Click="LogoutButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
