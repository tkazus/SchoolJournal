<Window x:Class="SchoolJournal.Client.Windows.HomeworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 Домашние задания" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📝 Домашние задания" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="ClassInfoText" Text="Класс: " FontSize="14" Foreground="#FF6B8A9A"/>
                <TextBlock x:Name="CountText" Text="Всего заданий: 0" FontSize="13" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HomeworkItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8FAFC" CornerRadius="8" Padding="12" Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFE8F0F8" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF6B8A9A" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{Binding DueDateColor}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DueDate, StringFormat=Срок: dd.MM.yyyy}" FontSize="12" Foreground="{Binding DueDateTextColor}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Teacher}" Foreground="#FF8A9AAA" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>