<Window x:Class="SchoolJournal.Client.Windows.ManageStudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👨‍🎓 Управление учениками" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="👨‍🎓 Управление учениками" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <Button Content="➕ Добавить ученика" Background="#FF6BB5A0" Foreground="White"
                        FontSize="13" FontWeight="SemiBold" Height="30" Width="130"
                        HorizontalAlignment="Right" Click="AddStudentButton_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StudentsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8FAFC" CornerRadius="8" Padding="12" Margin="0,3,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ClassName}" Foreground="#FF7A9AAA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Login}" Foreground="#FF8A9AAA" VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="3" Content="🗑️ Удалить" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                                        FontSize="12" FontWeight="SemiBold" Height="28" Width="80"
                                        Tag="{Binding StudentId}" Click="DeleteButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>