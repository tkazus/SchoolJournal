<Window x:Class="SchoolJournal.Client.Windows.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 Выставить оценку" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="📝 Выставить оценку" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock Text="Заполните все поля для выставления оценки" FontSize="13" Foreground="#FF8A9AAA"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="👨‍🎓 Ученик" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <ComboBox x:Name="StudentCombo" Height="35" Margin="0,0,0,15" 
                      DisplayMemberPath="Name" SelectedValuePath="StudentId"/>

            <TextBlock Text="📚 Предмет" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <ComboBox x:Name="SubjectCombo" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="📊 Оценка" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <ComboBox x:Name="GradeCombo" Height="35" Margin="0,0,0,15">
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>

            <TextBlock Text="💬 Комментарий (необязательно)" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
            <TextBox x:Name="CommentBox" Height="35" Padding="5" Background="White" 
                     BorderBrush="#FFD4E8F0" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✅ Сохранить" Background="#FF6BB5A0" Foreground="White"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="❌ Отмена" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>