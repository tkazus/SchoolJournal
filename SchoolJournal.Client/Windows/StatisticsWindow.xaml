<Window x:Class="SchoolJournal.Client.Windows.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📊 Статистика класса" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📊 Статистика класса" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="ClassInfoText" Text="Класс: " FontSize="14" Foreground="#FF6B8A9A"/>
            </StackPanel>
        </Border>

        <!-- Статистические карточки -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="👨‍🎓" FontSize="24"/>
                    <TextBlock Text="Всего учеников" FontSize="12" Foreground="#FF7A9AAA"/>
                    <TextBlock x:Name="TotalStudentsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,5,0" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="📊" FontSize="24"/>
                    <TextBlock Text="Средний балл" FontSize="12" Foreground="#FF7A9AAA"/>
                    <TextBlock x:Name="AvgGradeText" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,5,0" Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="✅" FontSize="24"/>
                    <TextBlock Text="Успеваемость" FontSize="12" Foreground="#FF7A9AAA"/>
                    <TextBlock x:Name="SuccessRateText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,0,0" Grid.Column="3">
                <StackPanel>
                    <TextBlock Text="🏆" FontSize="24"/>
                    <TextBlock Text="Отличников" FontSize="12" Foreground="#FF7A9AAA"/>
                    <TextBlock x:Name="ExcellentStudentsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Таблица учеников -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock Text="👨‍🎓 Список учеников" FontSize="16" FontWeight="SemiBold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>

                    <!-- Заголовки -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ФИО" FontWeight="Bold" Foreground="#FF6B8A9A" Grid.Column="0" Padding="5"/>
                        <TextBlock Text="Ср. балл" FontWeight="Bold" Foreground="#FF6B8A9A" Grid.Column="1" Padding="5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Посещаемость" FontWeight="Bold" Foreground="#FF6B8A9A" Grid.Column="2" Padding="5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Оценки" FontWeight="Bold" Foreground="#FF6B8A9A" Grid.Column="3" Padding="5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Жетоны" FontWeight="Bold" Foreground="#FF6B8A9A" Grid.Column="4" Padding="5" HorizontalAlignment="Center"/>
                    </Grid>

                    <ItemsControl x:Name="StudentsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="{Binding GradeColor}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="{Binding GradeTextColor}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Attendance, StringFormat={}{0:F0}%}" Foreground="#FF7A9AAA" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <ItemsControl Grid.Column="3" ItemsSource="{Binding RecentGrades}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding GradeColor}" CornerRadius="6" Padding="4,1" Margin="1">
                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{Binding GradeTextColor}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="4" Text="{Binding Tokens}" Foreground="#FF4A6B7A" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="3" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>