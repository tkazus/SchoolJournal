<Window x:Class="SchoolJournal.Client.Windows.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎒 Ученик" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🎒 Добро пожаловать!" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="StudentNameText" Text="Ученик" FontSize="14" Foreground="#FF6B8A9A"/>
                <TextBlock x:Name="ClassInfoText" Text="Класс: " FontSize="13" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Статистика -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="📊 Средний балл" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="AvgGradeText" Text="0.0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,5,0" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="✅ Посещаемость" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="AttendanceText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,5,0" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="📝 ДЗ на сегодня" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="HomeworkCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="15" Margin="5,0,0,0" Grid.Column="3">
                        <StackPanel>
                            <TextBlock Text="🪙 Жетоны" FontSize="12" Foreground="#FF7A9AAA"/>
                            <TextBlock x:Name="TokensText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Кнопки навигации -->
                <WrapPanel Margin="0,0,0,15">
                    <Button Content="📖 Оценки" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="GradesButton_Click"/>
                    <Button Content="📅 Расписание" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="ScheduleButton_Click"/>
                    <Button Content="📝 Домашнее задание" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="140" Margin="0,0,10,0"
                            Click="HomeworkButton_Click"/>
                    <Button Content="✅ Посещаемость" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="120" Margin="0,0,10,0"
                            Click="AttendanceButton_Click"/>
                    <Button Content="🪙 Жетоны" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="TokensButton_Click"/>
                    <Button Content="🏪 Магазин" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="100" Margin="0,0,10,0"
                            Click="ShopButton_Click"/>
                    <Button Content="🚪 Выход" Background="#FFE0D0D0" Foreground="#FF7A4A4A" 
                            FontSize="13" FontWeight="SemiBold" Height="35" Width="80"
                            Click="LogoutButton_Click"/>
                </WrapPanel>

                <!-- Последние оценки -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📋 Последние оценки" FontSize="16" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="GradesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                            <Border Grid.Column="1" Background="{Binding GradeColor}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="16" Foreground="{Binding GradeTextColor}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="#FF7A9AAA"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Teacher}" Foreground="#FF8A9AAA"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Расписание на сегодня -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📅 Расписание на сегодня" FontSize="16" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ScheduleItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF0F5FA" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Subject}" Foreground="#FF6B8A9A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Room}" Foreground="#FF8A9AAA" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Домашние задания -->
                <Border Background="White" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📝 Ближайшие ДЗ" FontSize="16" FontWeight="Bold" Foreground="#FF4A6B7A" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="HomeworkItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF5F8FC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF6B8A9A" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat=Срок: dd.MM.yyyy}" FontSize="12" Foreground="#FF8A9AAA" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>