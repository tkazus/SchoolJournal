<Window x:Class="SchoolJournal.Client.Windows.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✅ Посещаемость" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="✅ Посещаемость" FontSize="24" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock x:Name="StudentInfoText" Text="Ученик: " FontSize="14" Foreground="#FF6B8A9A"/>
                <WrapPanel Margin="0,10,0,0">
                    <Border Background="#FFB8E0C8" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="PresentCount" Text="✅ Присутствовал: 0" FontSize="12" Foreground="#FF2A6A4A"/>
                    </Border>
                    <Border Background="#FFE8D5A0" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="ExcusedCount" Text="⚕️ Уважительная: 0" FontSize="12" Foreground="#FF7A6A2A"/>
                    </Border>
                    <Border Background="#FFD5A8A8" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="AbsentCount" Text="❌ Отсутствовал: 0" FontSize="12" Foreground="#FF7A2A2A"/>
                    </Border>
                    <Border Background="#FFF0E8E8" CornerRadius="10" Padding="8,3">
                        <TextBlock x:Name="TotalCount" Text="📊 Всего: 0" FontSize="12" Foreground="#FF7A4A5A"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AttendanceItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8FAFC" CornerRadius="8" Padding="12" Margin="0,3,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="#FF7A9AAA" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{Binding StatusColor}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding StatusTextColor}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Comment}" Foreground="#FFAABACA" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="← Назад" Background="#FFE8D5F5" Foreground="#FF6B4A7A" 
                FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>