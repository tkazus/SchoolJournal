<Window x:Class="SchoolJournal.Client.Windows.MarkAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✅ Отметить посещаемость" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F0FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE8F0F8" CornerRadius="15" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="✅ Отметить посещаемость" FontSize="22" FontWeight="Bold" Foreground="#FF4A6B7A"/>
                <TextBlock Text="Выберите предмет и статус для каждого ученика" FontSize="13" Foreground="#FF8A9AAA"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="📚 Предмет" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
                <ComboBox x:Name="SubjectCombo" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="👨‍🎓 Ученики" FontWeight="SemiBold" Foreground="#FF6B8A9A" Margin="0,0,0,5"/>
                <ItemsControl x:Name="StudentsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF8FAFC" CornerRadius="8" Padding="10" Margin="0,3,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF4A6B7A" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="StatusCombo" Height="30" Width="160" Margin="5,0,0,0" Tag="{Binding StudentId}">
                                        <ComboBoxItem Content="✅ Присутствовал" IsSelected="True"/>
                                        <ComboBoxItem Content="❌ Отсутствовал"/>
                                        <ComboBoxItem Content="⚕️ Уважительная причина"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✅ Сохранить" Background="#FF6BB5A0" Foreground="White"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="❌ Отмена" Background="#FFE0D0D0" Foreground="#FF7A4A4A"
                    FontSize="13" FontWeight="SemiBold" Height="35" Width="100"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>